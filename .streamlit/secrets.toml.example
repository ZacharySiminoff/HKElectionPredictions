# Copy to .streamlit/secrets.toml (gitignored) and fill in real values.

[supabase]
# Project Settings -> Data API -> Project URL
url = "https://YOUR-PROJECT-REF.supabase.co"
# Project Settings -> API Keys -> secret key (sb_secret_...) or legacy service_role key.
# Server-side only. Never put this in client code or commit it.
service_role_key = "YOUR-SECRET-KEY"

[admin]
# Long random string; unlocks the Admin page.
password = "CHANGE-ME"

[app]
# IANA timezone used to display and edit the deadline.
timezone = "America/New_York"
